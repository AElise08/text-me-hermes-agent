#!/command/with-contenv sh
set -eu
export HOME=/var/lib/hermes HERMES_HOME=/var/lib/hermes TZ="${TZ:-America/Belem}"
while :; do
  wait=$(python3 /var/lib/hermes/scripts/schedule.py sleep-seconds)
  sleep "$wait"
  /command/s6-setuidgid hermes sh -c 'python3 /var/lib/hermes/scripts/morning_tick.py | python3 /var/lib/hermes/scripts/send_chat.py --file -' || true
done
